# Source IMAP mailbox
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX

# Outgoing SMTP relay.
# If omitted, SMTP_HOST is derived from IMAP_HOST (imap. -> smtp.) and the
# SMTP_USER/SMTP_PASS default to the IMAP credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com

# The mail-to-print destination each attachment is sent to.
PRINT_ADDR=your-printer@print.example.com

# Optional: only process messages whose subject (Betreff) contains this string
# (case-insensitive).
# SUBJECT_FILTER=Rechnung

# Optional: fixed subject (Betreff) set on every forwarded message.
# Defaults to the attachment filename when unset.
# PRINT_SUBJECT=Print job

# Optional: only forward these attachment extensions (comma-separated).
# ALLOW_EXT=pdf,jpg,png

# Optional: mark source messages \Seen after forwarding (default true).
# MARK_SEEN=true

# Optional: log actions without sending or marking anything (default false).
# DRY_RUN=false
